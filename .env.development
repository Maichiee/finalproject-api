generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id         String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  phone           String
  role            String           @default("user")
  is_verified     Boolean
  gender          String
  longitude       Float
  latitude        Float
  birthdate       DateTime
  education       String
  profile_picture String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  address         String           // String address (bukan relasi)
  companies       Company[]        @relation("UserCompanies")
  subscriptions   Subscription[]
  applications    Application[]

  @@map("users")
}

model Address {
  address_id     Int        @id @default(autoincrement())
  country        String
  province       String
  city           String
  district       String
  street         String
  postal_code    String
  latitude       Float
  longitude      Float
  companies      Company[]
  jobs           Job[]

  @@map("addresses")
}

model Company {
  company_id     Int        @id @default(autoincrement())
  name           String
  description    String
  logo           String?
  website        String
  contact        String
  social_links   String
  userId         String
  user           User       @relation("UserCompanies", fields: [userId], references: [user_id])
  addressId      Int
  address        Address    @relation(fields: [addressId], references: [address_id])
  jobs           Job[]

  @@map("companies")
}

model Job {
  job_id         Int        @id @default(autoincrement())
  title          String
  description    String
  job_type       String
  salary         Int
  tags           String
  deadline       DateTime
  is_published   Boolean    @default(false)
  created_at     DateTime   @default(now())
  companyId      Int
  company        Company    @relation(fields: [companyId], references: [company_id])
  addressId      Int
  address        Address    @relation(fields: [addressId], references: [address_id])
  applications   Application[]

  @@map("jobs")
}

model Application {
  application_id   Int       @id @default(autoincrement())
  cv_file          String
  salary_expectation Int
  status           String
  applied_at       DateTime  @default(now())
  userId           String
  user             User      @relation(fields: [userId], references: [user_id])
  jobId            Int
  job              Job       @relation(fields: [jobId], references: [job_id])

  @@map("applications")
}

model Subscription {
  subscription_id     Int       @id @default(autoincrement())
  started_at          DateTime  @default(now())
  ended_at            DateTime
  status              String
  payment_proof       String
  is_approved         Boolean   @default(false)
  subscriptionCategoryId Int
  subscriptioncategory Subcriptioncategory @relation(fields: [subscriptionCategoryId], references: [subscriptioncategory_id])
  userId              String
  user                User      @relation(fields: [userId], references: [user_id])

  @@map("subscriptions")
}

model Subcriptioncategory {
  subscriptioncategory_id Int      @id @default(autoincrement())
  name                   String
  price                  Int
  cv_generator_access    Boolean
  skill_assessment_limit Boolean
  priority_review        Boolean
  subscriptions          Subscription[]

  @@map("subscriptioncategories")
}
