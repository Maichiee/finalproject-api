generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id         String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String?        // Nullable for social login users
  phone           String?        // Nullable for social login users
  role            String         @default("user")
  is_verified     Boolean        @default(false)
  gender          String?        // Nullable for social login users
  longitude       Float?
  latitude        Float?
  birthdate       DateTime?      // Nullable for social login users
  education       String?        // Nullable for social login users
  profile_picture String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  address         String?        // Nullable for social login users
  
  // Social login and authentication fields
  auth_provider   String         @default("email") // email, google, facebook, twitter
  
  // Tracking fields
  verification_attempts Int @default(0)
  reset_password_used Boolean @default(false)
  
  companies       Company[]      @relation("UserCompanies")
  subscriptions   Subscription[]
  applications    Application[]

  @@map("users")
}

// Separate table for verification tokens
model VerificationToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("verification_tokens")
}

// Separate table for password reset tokens
model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("password_reset_tokens")
}

model Address {
  address_id  String @id @default(uuid())
  country     String
  province    String
  city        String
  district    String
  street      String
  postal_code String
  latitude    Float
  longitude   Float

  companies Company[]
  jobs      Job[]

  @@map("addresses")
}

model Company {
  company_id   String  @id @default(uuid())
  name         String
  description  String
  logo         String?
  website      String
  contact      String
  social_links String
  userId       String
  user         User    @relation("UserCompanies", fields: [userId], references: [user_id])
  addressId    String
  address      Address @relation(fields: [addressId], references: [address_id])
  jobs         Job[]

  @@map("companies")
}

model Job {
  job_id       String        @id @default(uuid())
  title        String
  description  String
  job_type     String
  salary       Int
  tags         String
  deadline     DateTime
  is_published Boolean       @default(false)
  created_at   DateTime      @default(now())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [company_id])
  addressId    String
  address      Address       @relation(fields: [addressId], references: [address_id])
  applications Application[]

  @@map("jobs")
}

model Application {
  application_id     String   @id @default(uuid())
  cv_file            String
  salary_expectation Int
  status             String
  applied_at         DateTime @default(now())
  userId             String
  user               User     @relation(fields: [userId], references: [user_id])
  jobId              String
  job                Job      @relation(fields: [jobId], references: [job_id])

  @@map("applications")
}

model Subscription {
  subscription_id        String               @id @default(uuid())
  started_at             DateTime             @default(now())
  ended_at               DateTime
  status                 String
  payment_proof          String
  is_approved            Boolean              @default(false)
  subscriptionCategoryId String
  subscriptioncategory   SubscriptionCategory @relation(fields: [subscriptionCategoryId], references: [subscriptioncategory_id])
  userId                 String
  user                   User                 @relation(fields: [userId], references: [user_id])

  @@map("subscriptions")
}

model SubscriptionCategory {
  subscriptioncategory_id String         @id @default(uuid())
  name                    String
  price                   Int
  cv_generator_access     Boolean
  skill_assessment_limit  Boolean
  priority_review         Boolean
  subscriptions           Subscription[]

  @@map("subscriptioncategories")
}
